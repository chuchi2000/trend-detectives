# Variables PÚBLICAS del frontend (Vite solo expone las que empiezan con VITE_).
# Nunca pongas aquí credenciales de NASA: todo lo que está aquí llega al navegador.

# URL base de la API. Vacío = mismo origen (en desarrollo, Vite redirige /api al backend).
VITE_API_URL=

# Estilo del mapa base (MapLibre). OpenFreeMap no requiere clave.
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
