# ---------------------------------------------------------------------------
# Copia este archivo como .env (en la raíz del proyecto) y completa tus datos.
# .env está en .gitignore: nunca se sube a Git. No compartas su contenido.
# ---------------------------------------------------------------------------

# --- NASA Earthdata Login (solo para los scripts de descarga) --------------
# Crea tu cuenta en https://urs.earthdata.nasa.gov/ (ver docs/07-earthdata.md).
# Opción A: usuario y contraseña
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Opción B: token generado en tu perfil de Earthdata (sustituye a la contraseña en earthaccess)
EARTHDATA_TOKEN=

# --- API ---------------------------------------------------------------------
# demo = datos SIMULADOS para desarrollar la interfaz
# real = archivos procesados de NASA registrados en data/catalog/catalog.json
ATLAS_DATA_MODE=demo
# Orígenes que pueden llamar a la API (el frontend de Vite en desarrollo)
ATLAS_CORS_ORIGINS=http://localhost:5173
ATLAS_LOG_LEVEL=INFO
# Opcional: otra ubicación para la carpeta de datos
# ATLAS_DATA_DIR=/ruta/a/data

# --- TiTiler (teselas de los COG para el mapa, modo real) ------------------------
TITILER_URL=http://localhost:8001
# Ruta de la carpeta data/ DENTRO del contenedor de TiTiler (ver docker-compose.yml)
TITILER_DATA_DIR=/data
