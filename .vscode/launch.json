{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API FastAPI (depurar)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Procesamiento: precipitación de prueba (julio 2015)",
      "type": "debugpy",
      "request": "launch",
      "module": "processing.cli",
      "args": ["precipitacion", "--inicio", "2015-07", "--fin", "2015-07"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
